package main

// #include <stdint.h>
// #include <stdlib.h>
// #include <string.h>
//
// // Callback function type for Go->Native method invocation.
// // Native code sets this callback; Go calls it on the calling thread to
// // start a native method call. Native replies exactly once through
// // DriftPlatformReply(callID, ...): before returning when it answers in
// // place, otherwise later from any thread.
// // Returns 0 once native has taken the call, non-zero if it could not
// // (Go then fails the call; native must not reply).
// typedef int (*DriftNativeMethodHandler)(
//     int64_t callID,
//     const char* channel,
//     const char* method,
//     const void* argsData,
//     int argsLen
// );
//
// // Store the native method handler
// static DriftNativeMethodHandler nativeMethodHandler = NULL;
//
// static inline void setNativeMethodHandler(DriftNativeMethodHandler handler) {
//     nativeMethodHandler = handler;
// }
//
// static inline int hasNativeMethodHandler() {
//     return nativeMethodHandler != NULL ? 1 : 0;
// }
//
// static inline int callNativeMethod(
//     int64_t callID,
//     const char* channel,
//     const char* method,
//     const void* argsData,
//     int argsLen
// ) {
//     if (nativeMethodHandler) {
//         return nativeMethodHandler(callID, channel, method, argsData, argsLen);
//     }
//     return -1; // No handler
// }
//
// // Callback for Go->Native frame scheduling (on-demand rendering)
// typedef void (*DriftScheduleFrameHandler)(void);
// static DriftScheduleFrameHandler scheduleFrameHandler = NULL;
//
// static inline void setScheduleFrameHandler(DriftScheduleFrameHandler handler) {
//     scheduleFrameHandler = handler;
// }
//
// static inline void callScheduleFrame(void) {
//     if (scheduleFrameHandler) {
//         scheduleFrameHandler();
//     }
// }
import "C"

import (
	"encoding/json"
	"fmt"
	"sync"
	"sync/atomic"
	"unsafe"

	"github.com/go-drift/drift/pkg/engine"
	"github.com/go-drift/drift/pkg/platform"
)

// nativePlatformBridge implements platform.NativeBridge using CGO callbacks.
type nativePlatformBridge struct{}

var (
	bridgeInstance = &nativePlatformBridge{}
	bridgeOnce     sync.Once

	// replies holds the reply callback of each native call in flight, by
	// call ID, until DriftPlatformReply takes it.
	replies    sync.Map // int64 -> func([]byte, error)
	nextCallID atomic.Int64
)

func init() {
	// Register the native bridge with the platform package
	bridgeOnce.Do(func() {
		platform.SetNativeBridge(bridgeInstance)
	})
}

// InvokeMethod starts a native method call on the calling thread (see
// platform.NativeBridge); native replies through DriftPlatformReply.
func (b *nativePlatformBridge) InvokeMethod(channel, method string, args []byte, reply func([]byte, error)) {
	if C.hasNativeMethodHandler() == 0 {
		reply(nil, platform.ErrPlatformUnavailable)
		return
	}
	id := nextCallID.Add(1)
	replies.Store(id, reply)

	channelC := C.CString(channel)
	defer C.free(unsafe.Pointer(channelC))
	methodC := C.CString(method)
	defer C.free(unsafe.Pointer(methodC))
	var argsPtr unsafe.Pointer
	if len(args) > 0 {
		argsPtr = C.CBytes(args)
		defer C.free(argsPtr)
	}

	if C.callNativeMethod(C.int64_t(id), channelC, methodC, argsPtr, C.int(len(args))) != 0 {
		// Unless native replied before failing (an error escaping after
		// the reply), the call has no reply coming.
		if _, pending := replies.LoadAndDelete(id); pending {
			reply(nil, platform.NewChannelError("native_error", "native could not take the call to "+channel+"."+method))
		}
	}
}

// DriftPlatformSetNativeHandler sets the callback for Go->Native method invocation.
// Native code must call this during initialization to enable platform channels.
// Go then tells native about the event channels subscribed before it could.
//
//export DriftPlatformSetNativeHandler
func DriftPlatformSetNativeHandler(handler C.DriftNativeMethodHandler) {
	C.setNativeMethodHandler(handler)
	platform.HandleNativeConnected()
}

// DriftPlatformReply delivers the reply to a native call started by
// InvokeMethod: data on success, or a JSON error payload in errorJSON
// (NULL on success). Native calls it exactly once per call, from any
// thread; Go copies the bytes, so native keeps ownership.
//
//export DriftPlatformReply
func DriftPlatformReply(callID C.int64_t, data unsafe.Pointer, dataLen C.int, errorJSON *C.char) {
	r, ok := replies.LoadAndDelete(int64(callID))
	if !ok {
		panic(fmt.Sprintf("drift: native replied to unknown call %d (a second reply, or a call it refused)", int64(callID)))
	}
	reply := r.(func([]byte, error))
	if errorJSON != nil {
		reply(nil, decodeNativeError(C.GoString(errorJSON)))
		return
	}
	var result []byte
	if data != nil && dataLen > 0 {
		result = C.GoBytes(data, dataLen)
	}
	reply(result, nil)
}

// DriftPlatformHandleEvent is called by native to dispatch an event to Go listeners.
//
//export DriftPlatformHandleEvent
func DriftPlatformHandleEvent(channelPtr *C.char, dataPtr unsafe.Pointer, dataLen C.int) {
	channel := C.GoString(channelPtr)

	var data []byte
	if dataLen > 0 && dataPtr != nil {
		data = C.GoBytes(dataPtr, dataLen)
	}

	platform.HandleEvent(channel, data)
}

// DriftPlatformHandleEventError is called by native when an event stream
// has an error: errorJSON is the same payload a failed call replies with
// (see DriftPlatformReply).
//
//export DriftPlatformHandleEventError
func DriftPlatformHandleEventError(channelPtr *C.char, errorJSON *C.char) {
	platform.HandleEventError(C.GoString(channelPtr), decodeNativeError(C.GoString(errorJSON)))
}

// DriftPlatformHandleEventDone is called by native when an event stream ends.
//
//export DriftPlatformHandleEventDone
func DriftPlatformHandleEventDone(channelPtr *C.char) {
	channel := C.GoString(channelPtr)
	platform.HandleEventDone(channel)
}

// DriftSetScheduleFrameHandler registers a native callback that Go invokes
// when it needs the platform to schedule a new frame. The native side (e.g.,
// Android JNI) provides a C function pointer; this bridges it into Go's
// engine.SetPlatformScheduleFrame mechanism.
//
//export DriftSetScheduleFrameHandler
func DriftSetScheduleFrameHandler(handler C.DriftScheduleFrameHandler) {
	C.setScheduleFrameHandler(handler)
	engine.SetPlatformScheduleFrame(func() {
		C.callScheduleFrame()
	})
}

// decodeNativeError decodes native's JSON error payload, or keeps payload
// as the message of a native_error if it is not one.
func decodeNativeError(payload string) *platform.ChannelError {
	var decoded platform.ChannelError
	if err := json.Unmarshal([]byte(payload), &decoded); err == nil {
		if decoded.Code != "" || decoded.Message != "" {
			return &decoded
		}
	}
	return platform.NewChannelError("native_error", payload)
}
